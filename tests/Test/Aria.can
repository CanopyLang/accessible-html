module Test.Aria exposing (main)

import Accessible.Aria as Aria
import Test exposing (Test, describe, test)
import Expect


main : Test
main =
    describe "Accessible.Aria"
        [ labelingTests
        , relationshipTests
        , stateTests
        , validationTests
        , currentTests
        , rangeTests
        , orientationTests
        , tableTests
        , setTests
        , levelTests
        , autoCompleteTests
        , popupTests
        , sortTests
        , miscTests
        ]


labelingTests : Test
labelingTests =
    describe "labeling"
        [ test "label creates aria-label" <| \_ ->
            let
                attr = Aria.label "Close dialog"
            in
            Expect.pass
        , test "labelledBy creates aria-labelledby" <| \_ ->
            let
                attr = Aria.labelledBy "title-id"
            in
            Expect.pass
        , test "labeledBy is alias for labelledBy" <| \_ ->
            let
                attr = Aria.labeledBy "title-id"
            in
            Expect.pass
        , test "describedBy joins IDs with space" <| \_ ->
            let
                attr = Aria.describedBy [ "desc1", "desc2" ]
            in
            Expect.pass
        , test "details creates aria-details" <| \_ ->
            let
                attr = Aria.details "details-id"
            in
            Expect.pass
        , test "roleDescription creates aria-roledescription" <| \_ ->
            let
                attr = Aria.roleDescription "slide"
            in
            Expect.pass
        , test "brailleLabel creates aria-braillelabel" <| \_ ->
            let
                attr = Aria.brailleLabel "Close"
            in
            Expect.pass
        ]


relationshipTests : Test
relationshipTests =
    describe "relationships"
        [ test "controls joins IDs" <| \_ ->
            let
                attr = Aria.controls [ "panel1", "panel2" ]
            in
            Expect.pass
        , test "owns joins IDs" <| \_ ->
            let
                attr = Aria.owns [ "child1", "child2" ]
            in
            Expect.pass
        , test "activeDescendant creates attribute" <| \_ ->
            let
                attr = Aria.activeDescendant "item-3"
            in
            Expect.pass
        , test "flowTo joins IDs" <| \_ ->
            let
                attr = Aria.flowTo [ "next1", "next2" ]
            in
            Expect.pass
        , test "errorMessage creates attribute" <| \_ ->
            let
                attr = Aria.errorMessage "err-msg"
            in
            Expect.pass
        ]


stateTests : Test
stateTests =
    describe "state"
        [ test "expanded true" <| \_ ->
            let
                attr = Aria.expanded True
            in
            Expect.pass
        , test "expanded false" <| \_ ->
            let
                attr = Aria.expanded False
            in
            Expect.pass
        , test "hidden true" <| \_ ->
            let
                attr = Aria.hidden True
            in
            Expect.pass
        , test "disabled true" <| \_ ->
            let
                attr = Aria.disabled True
            in
            Expect.pass
        , test "readOnly true" <| \_ ->
            let
                attr = Aria.readOnly True
            in
            Expect.pass
        , test "required true" <| \_ ->
            let
                attr = Aria.required True
            in
            Expect.pass
        , test "selected true" <| \_ ->
            let
                attr = Aria.selected True
            in
            Expect.pass
        , test "pressed Just True" <| \_ ->
            let
                attr = Aria.pressed (Just True)
            in
            Expect.pass
        , test "pressed Nothing is mixed" <| \_ ->
            let
                attr = Aria.pressed Nothing
            in
            Expect.pass
        , test "checked Just True" <| \_ ->
            let
                attr = Aria.checked (Just True)
            in
            Expect.pass
        , test "checked Nothing is mixed" <| \_ ->
            let
                attr = Aria.checked Nothing
            in
            Expect.pass
        , test "indeterminate creates mixed" <| \_ ->
            let
                attr = Aria.indeterminate
            in
            Expect.pass
        , test "modal true" <| \_ ->
            let
                attr = Aria.modal True
            in
            Expect.pass
        , test "multiLine true" <| \_ ->
            let
                attr = Aria.multiLine True
            in
            Expect.pass
        , test "multiSelectable true" <| \_ ->
            let
                attr = Aria.multiSelectable True
            in
            Expect.pass
        ]


validationTests : Test
validationTests =
    describe "validation"
        [ test "invalid true" <| \_ ->
            let
                attr = Aria.invalid True
            in
            Expect.pass
        , test "invalid false" <| \_ ->
            let
                attr = Aria.invalid False
            in
            Expect.pass
        , test "invalidGrammar" <| \_ ->
            let
                attr = Aria.invalidGrammar
            in
            Expect.pass
        , test "invalidSpelling" <| \_ ->
            let
                attr = Aria.invalidSpelling
            in
            Expect.pass
        ]


