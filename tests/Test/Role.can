convenienceTests : Test
convenienceTests =
    describe "convenience functions"
        [ test "alert returns attribute" <| \_ ->
            let
                attr = Role.alert
            in
            Expect.pass
        , test "dialog returns attribute" <| \_ ->
            let
                attr = Role.dialog
            in
            Expect.pass
        , test "role Navigation returns attribute" <| \_ ->
            let
                attr = Role.role Navigation
            in
            Expect.pass
        , test "custom creates custom role" <| \_ ->
            let
                attr = Role.custom "my-custom-role"
            in
            Expect.pass
        , test "button returns attribute" <| \_ ->
            let
                attr = Role.button
            in
            Expect.pass
        , test "tabList returns attribute" <| \_ ->
            let
                attr = Role.tabList
            in
            Expect.pass
        ]
