        , test "RowGroup" <| \_ ->
            Expect.equal (Role.roleToString RowGroup) "rowgroup"
        , test "RowHeader" <| \_ ->
            Expect.equal (Role.roleToString RowHeader) "rowheader"
        , test "Table" <| \_ ->
            Expect.equal (Role.roleToString Table) "table"
        , test "Term" <| \_ ->
            Expect.equal (Role.roleToString Term) "term"
        , test "Time" <| \_ ->
            Expect.equal (Role.roleToString Time) "time"
        , test "Banner" <| \_ ->
            Expect.equal (Role.roleToString Banner) "banner"
        , test "Complementary" <| \_ ->
            Expect.equal (Role.roleToString Complementary) "complementary"
        , test "ContentInfo" <| \_ ->
