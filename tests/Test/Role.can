        , test "Timer" <| \_ ->
            Expect.equal (Role.roleToString Timer) "timer"
        , test "ToolBar" <| \_ ->
            Expect.equal (Role.roleToString ToolBar) "toolbar"
        , test "ToolTip" <| \_ ->
            Expect.equal (Role.roleToString ToolTip) "tooltip"
        , test "Tree" <| \_ ->
            Expect.equal (Role.roleToString Tree) "tree"
        , test "TreeGrid" <| \_ ->
            Expect.equal (Role.roleToString TreeGrid) "treegrid"
        , test "TreeItem" <| \_ ->
