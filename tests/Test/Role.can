module Test.Role exposing (main)

import Accessible.Role as Role exposing (Role(..))
import Test exposing (Test, describe, test)
import Expect


main : Test
main =
    describe "Accessible.Role"
        [ roleToStringTests
        , convenienceTests
        ]


roleToStringTests : Test
roleToStringTests =
    describe "roleToString"
        [ test "Alert" <| \_ ->
            Expect.equal (Role.roleToString Alert) "alert"
        , test "AlertDialog" <| \_ ->
            Expect.equal (Role.roleToString AlertDialog) "alertdialog"
        , test "Button" <| \_ ->
            Expect.equal (Role.roleToString Button) "button"
        , test "CheckBox" <| \_ ->
            Expect.equal (Role.roleToString CheckBox) "checkbox"
        , test "ComboBox" <| \_ ->
            Expect.equal (Role.roleToString ComboBox) "combobox"
        , test "Dialog" <| \_ ->
            Expect.equal (Role.roleToString Dialog) "dialog"
        , test "GridCell" <| \_ ->
            Expect.equal (Role.roleToString GridCell) "gridcell"
        , test "Link" <| \_ ->
            Expect.equal (Role.roleToString Link) "link"
        , test "Log" <| \_ ->
            Expect.equal (Role.roleToString Log) "log"
        , test "Marquee" <| \_ ->
            Expect.equal (Role.roleToString Marquee) "marquee"
        , test "Menu" <| \_ ->
            Expect.equal (Role.roleToString Menu) "menu"
        , test "MenuBar" <| \_ ->
            Expect.equal (Role.roleToString MenuBar) "menubar"
        , test "MenuItem" <| \_ ->
            Expect.equal (Role.roleToString MenuItem) "menuitem"
        , test "MenuItemCheckBox" <| \_ ->
            Expect.equal (Role.roleToString MenuItemCheckBox) "menuitemcheckbox"
        , test "MenuItemRadio" <| \_ ->
            Expect.equal (Role.roleToString MenuItemRadio) "menuitemradio"
        , test "Option" <| \_ ->
            Expect.equal (Role.roleToString Option) "option"
        , test "ProgressBar" <| \_ ->
            Expect.equal (Role.roleToString ProgressBar) "progressbar"
        , test "Radio" <| \_ ->
            Expect.equal (Role.roleToString Radio) "radio"
        , test "RadioGroup" <| \_ ->
            Expect.equal (Role.roleToString RadioGroup) "radiogroup"
        , test "ScrollBar" <| \_ ->
            Expect.equal (Role.roleToString ScrollBar) "scrollbar"
        , test "Separator" <| \_ ->
            Expect.equal (Role.roleToString Separator) "separator"
        , test "Slider" <| \_ ->
            Expect.equal (Role.roleToString Slider) "slider"
        , test "SpinButton" <| \_ ->
            Expect.equal (Role.roleToString SpinButton) "spinbutton"
        , test "Status" <| \_ ->
            Expect.equal (Role.roleToString Status) "status"
        , test "Switch" <| \_ ->
            Expect.equal (Role.roleToString Switch) "switch"
        , test "Tab" <| \_ ->
            Expect.equal (Role.roleToString Tab) "tab"
        , test "TabList" <| \_ ->
