        , test "Main" <| \_ ->
            Expect.equal (Role.roleToString Main) "main"
        , test "Navigation" <| \_ ->
            Expect.equal (Role.roleToString Navigation) "navigation"
        , test "Region" <| \_ ->
            Expect.equal (Role.roleToString Region) "region"
        , test "Search" <| \_ ->
            Expect.equal (Role.roleToString Search) "search"
        , test "Comment" <| \_ ->
            Expect.equal (Role.roleToString Comment) "comment"
        , test "Deletion" <| \_ ->
            Expect.equal (Role.roleToString Deletion) "deletion"
        , test "Emphasis" <| \_ ->
