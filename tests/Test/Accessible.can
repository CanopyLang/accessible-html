inputTests : Test
inputTests =
    describe "inputs"
        [ test "inputText creates text input" <| \_ ->
            let
                node = Accessible.inputText "hello" []
            in
            Expect.pass
        , test "inputNumber creates number input" <| \_ ->
            let
                node = Accessible.inputNumber "42" []
            in
            Expect.pass
        , test "radio creates radio button" <| \_ ->
            let
                node = Accessible.radio "group" "val" True []
            in
            Expect.pass
        , test "checkbox creates checkbox with checked state" <| \_ ->
            let
                node = Accessible.checkbox "val" (Just True) []
            in
            Expect.pass
        , test "checkbox creates indeterminate checkbox" <| \_ ->
            let
                node = Accessible.checkbox "val" Nothing []
            in
            Expect.pass
        , test "textarea creates textarea" <| \_ ->
            let
                node = Accessible.textarea [] [ Accessible.text "content" ]
            in
            Expect.pass
        , test "select creates select" <| \_ ->
            let
                node = Accessible.select [] []
            in
            Expect.pass
        ]


buttonTests : Test
buttonTests =
    describe "button"
        [ test "button creates button element" <| \_ ->
            let
                node = Accessible.button [] [ Accessible.text "Click" ]
            in
            Expect.pass
        ]


labelTests : Test
labelTests =
    describe "labels"
        [ test "labelBefore wraps label before input" <| \_ ->
            let
                node =
                    Accessible.labelBefore []
                        (Accessible.text "Email")
                        (Accessible.inputText "test@example.com" [])
            in
            Expect.pass
        , test "labelAfter wraps label after input" <| \_ ->
            let
                node =
                    Accessible.labelAfter []
                        (Accessible.text "I agree")
                        (Accessible.checkbox "agree" (Just False) [])
            in
            Expect.pass
        , test "labelHidden creates hidden label" <| \_ ->
            let
                node =
                    Accessible.labelHidden "Search"
                        []
                        (Accessible.text "Search")
                        (Accessible.inputText "" [])
            in
            Expect.pass
        ]


