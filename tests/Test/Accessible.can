module Test.Accessible exposing (main)

import Accessible
import Html.Attributes
import Test exposing (Test, describe, test)
import Expect


main : Test
main =
    describe "Accessible"
        [ textTests
        , headingTests
        , groupingTests
        , textSemanticTests
        , listTests
        , sectionTests
        , tableTests
        , formTests
        , mediaTests
        , embeddedTests
        , editTests
        , interactiveTests
        , imageTests
        , inputTests
        , buttonTests
        , labelTests
        , tabTests
        ]


textTests : Test
textTests =
    describe "text"
        [ test "creates a text node" <| \_ ->
            let
                node = Accessible.text "hello"
            in
            Expect.pass
        ]


headingTests : Test
headingTests =
    describe "headings"
        [ test "h1 creates heading" <| \_ ->
            let
                node = Accessible.h1 [] [ Accessible.text "Title" ]
            in
            Expect.pass
        , test "h2 creates heading" <| \_ ->
            let
                node = Accessible.h2 [] [ Accessible.text "Subtitle" ]
            in
            Expect.pass
        , test "h3 creates heading" <| \_ ->
            let
                node = Accessible.h3 [] [ Accessible.text "Section" ]
            in
            Expect.pass
        , test "h4 creates heading" <| \_ ->
            let
                node = Accessible.h4 [] [ Accessible.text "Subsection" ]
            in
            Expect.pass
        , test "h5 creates heading" <| \_ ->
            let
                node = Accessible.h5 [] [ Accessible.text "Detail" ]
            in
            Expect.pass
        , test "h6 creates heading" <| \_ ->
            let
                node = Accessible.h6 [] [ Accessible.text "Fine detail" ]
            in
            Expect.pass
        ]


groupingTests : Test
groupingTests =
    describe "grouping content"
