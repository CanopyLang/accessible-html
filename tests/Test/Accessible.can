tabTests =
    describe "tabs"
        [ test "tabList creates tablist container" <| \_ ->
            let
                node = Accessible.tabList [] []
            in
            Expect.pass
        , test "tab creates tab element" <| \_ ->
            let
                node = Accessible.tab [] [ Accessible.text "Tab 1" ]
            in
            Expect.pass
        , test "tabPanel creates tab panel" <| \_ ->
            let
                node = Accessible.tabPanel [] [ Accessible.text "Content" ]
            in
            Expect.pass
        ]
