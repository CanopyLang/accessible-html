        , test "p creates paragraph" <| \_ ->
            let
                node = Accessible.p [] [ Accessible.text "text" ]
            in
            Expect.pass
        , test "hr creates horizontal rule" <| \_ ->
            let
                node = Accessible.hr [] []
            in
            Expect.pass
        , test "pre creates preformatted text" <| \_ ->
            let
                node = Accessible.pre [] [ Accessible.text "code" ]
            in
            Expect.pass
        , test "blockquote creates quotation" <| \_ ->
            let
                node = Accessible.blockquote [] [ Accessible.text "quote" ]
            in
            Expect.pass
        ]


textSemanticTests : Test
textSemanticTests =
    describe "text semantics"
        [ test "span creates inline container" <| \_ ->
            let
                node = Accessible.span [] [ Accessible.text "inline" ]
            in
            Expect.pass
        , test "a creates anchor" <| \_ ->
            let
                node = Accessible.a [] [ Accessible.text "link" ]
            in
            Expect.pass
        , test "code creates code element" <| \_ ->
            let
                node = Accessible.code [] [ Accessible.text "x = 1" ]
            in
            Expect.pass
        , test "em creates emphasis" <| \_ ->
            let
                node = Accessible.em [] [ Accessible.text "emphasis" ]
            in
            Expect.pass
        , test "strong creates strong text" <| \_ ->
            let
                node = Accessible.strong [] [ Accessible.text "important" ]
            in
            Expect.pass
        , test "i creates italic text" <| \_ ->
            let
                node = Accessible.i [] [ Accessible.text "italic" ]
            in
            Expect.pass
        , test "b creates bold text" <| \_ ->
            let
                node = Accessible.b [] [ Accessible.text "bold" ]
            in
            Expect.pass
        , test "u creates underline" <| \_ ->
            let
                node = Accessible.u [] [ Accessible.text "underline" ]
            in
            Expect.pass
        , test "sub creates subscript" <| \_ ->
            let
                node = Accessible.sub [] [ Accessible.text "2" ]
            in
            Expect.pass
        , test "sup creates superscript" <| \_ ->
            let
                node = Accessible.sup [] [ Accessible.text "2" ]
            in
            Expect.pass
        , test "br creates line break" <| \_ ->
            let
                node = Accessible.br []
            in
            Expect.pass
        , test "small creates small text" <| \_ ->
            let
                node = Accessible.small [] [ Accessible.text "fine print" ]
            in
            Expect.pass
        , test "cite creates citation" <| \_ ->
            let
                node = Accessible.cite [] [ Accessible.text "source" ]
