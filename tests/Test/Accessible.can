            Expect.pass
        , test "var creates variable" <| \_ ->
            let
                node = Accessible.var [] [ Accessible.text "x" ]
            in
            Expect.pass
        , test "samp creates sample output" <| \_ ->
            let
                node = Accessible.samp [] [ Accessible.text "output" ]
            in
            Expect.pass
        , test "kbd creates keyboard input" <| \_ ->
            let
                node = Accessible.kbd [] [ Accessible.text "Ctrl" ]
            in
            Expect.pass
        , test "s creates strikethrough" <| \_ ->
            let
                node = Accessible.s [] [ Accessible.text "old" ]
            in
            Expect.pass
        , test "q creates inline quote" <| \_ ->
            let
                node = Accessible.q [] [ Accessible.text "quoted" ]
            in
            Expect.pass
        , test "mark creates highlight" <| \_ ->
            let
                node = Accessible.mark [] [ Accessible.text "marked" ]
            in
            Expect.pass
        , test "ruby creates annotation" <| \_ ->
            let
                node = Accessible.ruby [] [ Accessible.text "text" ]
            in
            Expect.pass
        , test "rt creates ruby text" <| \_ ->
            let
                node = Accessible.rt [] [ Accessible.text "annotation" ]
            in
            Expect.pass
        , test "rp creates ruby paren" <| \_ ->
            let
                node = Accessible.rp [] [ Accessible.text "(" ]
            in
            Expect.pass
        , test "bdi creates bidi isolation" <| \_ ->
            let
                node = Accessible.bdi [] [ Accessible.text "text" ]
            in
            Expect.pass
        , test "bdo creates bidi override" <| \_ ->
            let
                node = Accessible.bdo [] [ Accessible.text "text" ]
            in
            Expect.pass
        , test "wbr creates word break" <| \_ ->
            let
                node = Accessible.wbr [] [ Accessible.text "" ]
            in
            Expect.pass
        ]


listTests : Test
listTests =
    describe "lists"
        [ test "ol creates ordered list" <| \_ ->
            let
