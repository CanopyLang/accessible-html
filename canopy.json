{
    "type": "package",
    "name": "canopy/accessible-html",
    "summary": "Type-enforced accessibility for Canopy HTML",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": {
        "Core": [
            "Accessible"
        ],
        "ARIA": [
            "Accessible.Aria",
            "Accessible.Role",
            "Accessible.Landmark",
            "Accessible.Live"
        ],
        "Interaction": [
            "Accessible.Key",
            "Accessible.Focus",
            "Accessible.Style"
        ]
    },
    "canopy-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "canopy/core": "1.0.0 <= v < 2.0.0",
        "canopy/html": "1.0.0 <= v < 2.0.0",
        "canopy/virtual-dom": "1.0.0 <= v < 2.0.0",
        "canopy/json": "1.0.0 <= v < 2.0.0",
        "canopy/browser": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "canopy/test": "1.0.0 <= v < 2.0.0"
    }
}
