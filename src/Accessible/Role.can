module Accessible.Role exposing
    ( Role(..)
    , role, roleToString, custom
    , alert, alertDialog, application, article
    , button, checkBox, code, columnHeader, comboBox, comment
    , definition, deletion, dialog, directory, document
    , emphasis
    , feed, figure, grid, gridCell, group
    , heading
    , img, insertion
    , link, list, listBox, listItem, log
    , mark, marquee, math, menu, menuBar, menuItem
    , menuItemCheckBox, menuItemRadio, meter
    , none, note
    , option
    , presentation, progressBar
    , radio, radioGroup, row, rowGroup, rowHeader
    , scrollBar, separator, slider, spinButton, status
    , strong, subscript, suggestion, superscript, switch
    , tab, tabList, tabPanel, textBox, time, timer
    , toolBar, toolTip, tree, treeGrid, treeItem
    )

{-| All WAI-ARIA roles as a closed union type and attribute helpers.
Prevents typos and provides exhaustive documentation of available roles.

# Type
@docs Role

# Core
@docs role, roleToString, custom

# Widget Roles
@docs alert, alertDialog, button, checkBox, comboBox, dialog
@docs gridCell, link, log, marquee, menu, menuBar, menuItem
@docs menuItemCheckBox, menuItemRadio, option, progressBar
@docs radio, radioGroup, scrollBar, separator, slider, spinButton
@docs status, switch, tab, tabList, tabPanel, textBox, timer
@docs toolBar, toolTip, tree, treeGrid, treeItem

# Document Structure Roles
@docs application, article, code, columnHeader, definition, directory
@docs document, feed, figure, grid, group, heading, img, list, listBox
@docs listItem, math, meter, none, note, presentation, row, rowGroup
@docs rowHeader

# Annotation Roles
@docs comment, deletion, emphasis, insertion, mark, strong
@docs subscript, suggestion, superscript

-}

import Html
import VirtualDom


{-| All WAI-ARIA roles as a closed union type. Prevents typos and provides
exhaustive documentation of available roles.
-}
type Role
    = Alert
    | AlertDialog
    | Button
    | CheckBox
    | ComboBox
    | Dialog
    | GridCell
    | Link
    | Log
    | Marquee
    | Menu
    | MenuBar
    | MenuItem
    | MenuItemCheckBox
    | MenuItemRadio
    | Option
    | ProgressBar
    | Radio
    | RadioGroup
    | ScrollBar
    | Separator
    | Slider
    | SpinButton
    | Status
    | Switch
    | Tab
    | TabList
    | TabPanel
    | TextBox
    | Timer
    | ToolBar
    | ToolTip
    | Tree
    | TreeGrid
    | TreeItem
    | Application
    | Article
    | Code
    | ColumnHeader
    | Definition
    | Directory
    | Document
    | Feed
    | Figure
    | Grid
    | Group
    | Heading
    | Img
    | List
    | ListBox
    | ListItem
    | Math
    | Meter
    | None
    | Note
    | Presentation
    | Row
    | RowGroup
    | RowHeader
    | Table
    | Term
    | Time
    | Banner
    | Complementary
    | ContentInfo
    | Form
    | Main
    | Navigation
    | Region
    | Search
    | Comment
    | Deletion
    | Emphasis
    | Insertion
    | Mark
    | Strong
    | Subscript
    | Suggestion
    | Superscript


{-| Set the role attribute to a typed Role value. Compiles to the correct
ARIA role string.

    div [ Accessible.Role.role Accessible.Role.Alert ] [ text "Error occurred" ]
-}
role : Role -> Html.Attribute msg
role r =
    VirtualDom.attribute "role" (roleToString r)


{-| Render a Role to its WAI-ARIA string representation.
E.g., AlertDialog -> "alertdialog", MenuItemCheckBox -> "menuitemcheckbox"
-}
roleToString : Role -> String
roleToString r =
    case r of
        Alert -> "alert"
        AlertDialog -> "alertdialog"
        Button -> "button"
        CheckBox -> "checkbox"
        ComboBox -> "combobox"
        Dialog -> "dialog"
        GridCell -> "gridcell"
        Link -> "link"
        Log -> "log"
        Marquee -> "marquee"
        Menu -> "menu"
        MenuBar -> "menubar"
        MenuItem -> "menuitem"
        MenuItemCheckBox -> "menuitemcheckbox"
        MenuItemRadio -> "menuitemradio"
        Option -> "option"
        ProgressBar -> "progressbar"
        Radio -> "radio"
        RadioGroup -> "radiogroup"
        ScrollBar -> "scrollbar"
        Separator -> "separator"
        Slider -> "slider"
        SpinButton -> "spinbutton"
        Status -> "status"
        Switch -> "switch"
        Tab -> "tab"
        TabList -> "tablist"
        TabPanel -> "tabpanel"
        TextBox -> "textbox"
        Timer -> "timer"
        ToolBar -> "toolbar"
        ToolTip -> "tooltip"
        Tree -> "tree"
        TreeGrid -> "treegrid"
        TreeItem -> "treeitem"
        Application -> "application"
        Article -> "article"
        Code -> "code"
        ColumnHeader -> "columnheader"
        Definition -> "definition"
        Directory -> "directory"
        Document -> "document"
        Feed -> "feed"
        Figure -> "figure"
        Grid -> "grid"
        Group -> "group"
        Heading -> "heading"
        Img -> "img"
        List -> "list"
        ListBox -> "listbox"
        ListItem -> "listitem"
        Math -> "math"
        Meter -> "meter"
        None -> "none"
        Note -> "note"
        Presentation -> "presentation"
        Row -> "row"
        RowGroup -> "rowgroup"
        RowHeader -> "rowheader"
        Table -> "table"
        Term -> "term"
        Time -> "time"
        Banner -> "banner"
        Complementary -> "complementary"
        ContentInfo -> "contentinfo"
        Form -> "form"
        Main -> "main"
        Navigation -> "navigation"
        Region -> "region"
        Search -> "search"
        Comment -> "comment"
        Deletion -> "deletion"
        Emphasis -> "emphasis"
        Insertion -> "insertion"
        Mark -> "mark"
        Strong -> "strong"
        Subscript -> "subscript"
        Suggestion -> "suggestion"
        Superscript -> "superscript"


{-| Set role to a custom string. Escape hatch for roles not in the union type.
Prefer the typed Role constructors when possible.
-}
custom : String -> Html.Attribute msg
custom =
    VirtualDom.attribute "role"


