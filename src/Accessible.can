-- FORMS


{-| A form element without event handlers. Non-interactive. -}
form : List (Attribute Never) -> List (Html msg) -> Html msg
form attrs children =
    VirtualDom.node "form"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A form element that accepts event handlers (e.g., onSubmit). -}
formWithListeners : List (Attribute msg) -> List (Html msg) -> Html msg
formWithListeners =
    VirtualDom.node "form"


{-| A set of controls. Non-interactive. -}
fieldset : List (Attribute Never) -> List (Html msg) -> Html msg
fieldset attrs children =
    VirtualDom.node "fieldset"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| The caption for a fieldset. Non-interactive. -}
