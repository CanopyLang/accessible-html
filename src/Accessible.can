module Accessible exposing
    ( Html, Attribute
    , text, node, map
    , h1, h2, h3, h4, h5, h6
    , div, p, hr, pre, blockquote
    , span, a, code, em, strong, i, b, u, sub, sup, br
    , small, cite, dfn, abbr, time, var, samp, kbd, s, q
    , mark, ruby, rt, rp, bdi, bdo, wbr
    , ol, ul, li, dl, dt, dd
    , img, decorativeImg, figure
    , button
    , inputText, inputNumber, radio, checkbox
    , textarea, select
    , tabList, tab, tabPanel
    , section, nav, article, aside, header, footer, address, main_
    , figcaption
    , table, caption, colgroup, col, tbody, thead, tfoot, tr, td, th
    , form, formWithListeners, fieldset, legend, label
    , datalist, optgroup, option, output, progress, meter
    , audio, video, source, track, iframe, canvas, math
    , embed, object, param
    , ins, del
    , details, summary, menuitem, menu
    , labelBefore, labelAfter, labelHidden
    )

{-| Type-enforced accessibility for Canopy HTML. A drop-in replacement for
the `Html` module that makes common accessibility violations impossible at
compile time: images require alt text, inputs require labels, buttons require
accessible names, and non-interactive elements cannot receive event handlers.

# Primitives
@docs Html, Attribute, text, node, map

# Labels
@docs labelBefore, labelAfter, labelHidden

# Inputs
@docs inputText, inputNumber, radio, checkbox, textarea, select

# Buttons
@docs button

# Images
@docs img, decorativeImg, figure

# Tabs
@docs tabList, tab, tabPanel

# Headers
@docs h1, h2, h3, h4, h5, h6

# Grouping Content
@docs div, p, hr, pre, blockquote

# Text
@docs span, a, code, em, strong, i, b, u, sub, sup, br
@docs small, cite, dfn, abbr, time, var, samp, kbd, s, q
@docs mark, ruby, rt, rp, bdi, bdo, wbr

# Lists
@docs ol, ul, li, dl, dt, dd

# Sections
@docs section, nav, article, aside, header, footer, address, main_

# Figures
@docs figcaption

# Tables
@docs table, caption, colgroup, col, tbody, thead, tfoot, tr, td, th

# Forms
@docs form, formWithListeners, fieldset, legend, label
@docs datalist, optgroup, option, output, progress, meter

# Media
@docs audio, video, source, track, iframe, canvas, math

# Embedded Objects
@docs embed, object, param

# Text Edits
@docs ins, del

# Interactive Elements
@docs details, summary, menuitem, menu
-}

import Html
import Html.Attributes
import Json.Encode as Json
import VirtualDom


-- CORE TYPES


{-| An accessible HTML node. Identical to Html.Html but constructed through
functions that enforce accessibility requirements.
-}
type alias Html msg = Html.Html msg


{-| An accessible HTML attribute. For non-interactive elements, the msg type
is Never, preventing event handler attachment at compile time.
-}
type alias Attribute msg = Html.Attribute msg


-- PRIMITIVES


{-| Plain text node. -}
text : String -> Html msg
text =
    Html.text


{-| General node constructor. Prefer the specific element functions when
possible, as they enforce accessibility constraints.
-}
node : String -> List (Attribute msg) -> List (Html msg) -> Html msg
node =
    Html.node


{-| Transform the messages produced by an Html value. -}
map : (a -> msg) -> Html a -> Html msg
map =
    Html.map


-- LABELS


{-| Visually render a label before the input it describes. The label text
is the second argument (Html Never -- no event handlers on labels).
The input is the third argument.

    Accessible.labelBefore []
        (Accessible.text "Email")
        (Accessible.inputText "email" [])
-}
labelBefore : List (Attribute Never) -> Html Never -> Html msg -> Html msg
labelBefore attrs labelContent input_ =
    VirtualDom.node "label"
        (List.map (Html.Attributes.map Basics.never) attrs)
        [ Html.map Basics.never labelContent
        , input_
        ]


{-| Visually render a label after the input it describes.

    Accessible.labelAfter []
        (Accessible.text "I agree to the terms")
        (Accessible.checkbox "agree" (Just False) [])
-}
labelAfter : List (Attribute Never) -> Html Never -> Html msg -> Html msg
labelAfter attrs labelContent input_ =
    VirtualDom.node "label"
        (List.map (Html.Attributes.map Basics.never) attrs)
        [ input_
        , Html.map Basics.never labelContent
        ]


{-| Create a label that is visually hidden but announced by screen readers.
The String argument is the label text. Useful when the visual context
makes a visible label redundant but screen readers need it.

    Accessible.labelHidden "Search"
        []
        (Accessible.text "Search")
        (Accessible.inputText "search" [ Html.Attributes.placeholder "Search..." ])
-}
labelHidden : String -> List (Attribute Never) -> Html Never -> Html msg -> Html msg
labelHidden labelText attrs labelContent input_ =
    VirtualDom.node "label"
        (List.map (Html.Attributes.map Basics.never) attrs)
        [ VirtualDom.node "span" invisibleStyles
            [ Html.map Basics.never labelContent ]
        , input_
        ]


-- INPUTS


{-| A text input. The String argument is the input's value.
Must be wrapped in a labelBefore, labelAfter, or labelHidden.

    Accessible.labelBefore []
        (Accessible.text "Username")
        (Accessible.inputText "username-value" [ onInput UsernameChanged ])
-}
inputText : String -> List (Attribute msg) -> Html msg
inputText val attrs =
    VirtualDom.node "input"
        (VirtualDom.attribute "type" "text"
            :: VirtualDom.property "value" (Json.string val)
            :: attrs
        )
        []


{-| A number input. The String argument is the input's value. -}
inputNumber : String -> List (Attribute msg) -> Html msg
inputNumber val attrs =
    VirtualDom.node "input"
        (VirtualDom.attribute "type" "number"
            :: VirtualDom.property "value" (Json.string val)
            :: attrs
        )
        []


{-| A radio button. Arguments: group name, value, whether checked, attributes. -}
radio : String -> String -> Bool -> List (Attribute msg) -> Html msg
radio groupName val isChecked attrs =
    VirtualDom.node "input"
        (VirtualDom.attribute "type" "radio"
            :: VirtualDom.property "name" (Json.string groupName)
            :: VirtualDom.property "value" (Json.string val)
            :: VirtualDom.property "checked" (Json.bool isChecked)
            :: attrs
        )
        []


{-| A checkbox. Arguments: value, checked state (Nothing = indeterminate). -}
checkbox : String -> Maybe Bool -> List (Attribute msg) -> Html msg
checkbox val checkedState attrs =
    let
        checkedAttrs =
            case checkedState of
                Just isChecked ->
                    [ VirtualDom.property "checked" (Json.bool isChecked) ]

                Nothing ->
                    [ VirtualDom.property "checked" (Json.bool False)
                    , VirtualDom.attribute "aria-checked" "mixed"
                    ]
    in
    VirtualDom.node "input"
        (VirtualDom.attribute "type" "checkbox"
            :: VirtualDom.property "value" (Json.string val)
            :: checkedAttrs ++ attrs
        )
        []


{-| A multi-line text area. Accepts event handler attributes. -}
textarea : List (Attribute msg) -> List (Html msg) -> Html msg
textarea =
    VirtualDom.node "textarea"


{-| A select dropdown. Accepts event handler attributes. -}
select : List (Attribute msg) -> List (Html msg) -> Html msg
select =
    VirtualDom.node "select"


-- BUTTONS


{-| A button element. Accepts event handlers. Must contain text content
or have an aria-label attribute for screen reader accessibility.

    Accessible.button [ onClick Save ] [ Accessible.text "Save" ]
-}
button : List (Attribute msg) -> List (Html msg) -> Html msg
button =
    VirtualDom.node "button"


-- IMAGES


{-| An image with required alt text. The String argument is the alt text
describing the image for screen readers. Cannot be empty -- use
decorativeImg for images that convey no information.

    Accessible.img "A golden retriever playing in a park" [ src "dog.jpg" ]
-}
img : String -> List (Attribute Never) -> Html msg
img altText attrs =
    VirtualDom.node "img"
        (VirtualDom.property "alt" (Json.string altText)
            :: List.map (Html.Attributes.map Basics.never) attrs
        )
        []


{-| A decorative image that conveys no information. Automatically given
role="presentation" and an empty alt attribute so screen readers skip it.

    Accessible.decorativeImg [ src "divider.png" ]
-}
decorativeImg : List (Attribute Never) -> Html msg
decorativeImg attrs =
    VirtualDom.node "img"
        (VirtualDom.property "alt" (Json.string "")
            :: VirtualDom.attribute "role" "presentation"
            :: List.map (Html.Attributes.map Basics.never) attrs
        )
        []


{-| A figure element with a required figcaption. -}
figure : List (Attribute Never) -> List (Html msg) -> Html msg
figure attrs children =
    VirtualDom.node "figure"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


-- TABS


{-| A tab list container. Non-interactive wrapper. -}
tabList : List (Attribute Never) -> List (Html msg) -> Html msg
tabList attrs children =
    VirtualDom.node "div"
        (VirtualDom.attribute "role" "tablist"
            :: List.map (Html.Attributes.map Basics.never) attrs
        )
        children


{-| A single tab. Interactive (accepts event handlers like onClick). -}
tab : List (Attribute msg) -> List (Html msg) -> Html msg
tab attrs children =
    VirtualDom.node "div"
        (VirtualDom.attribute "role" "tab" :: attrs)
        children


{-| A tab panel. Non-interactive container for tab content. -}
tabPanel : List (Attribute Never) -> List (Html msg) -> Html msg
tabPanel attrs children =
    VirtualDom.node "div"
        (VirtualDom.attribute "role" "tabpanel"
            :: List.map (Html.Attributes.map Basics.never) attrs
        )
        children


-- NON-INTERACTIVE ELEMENTS


{-| Heading level 1. Non-interactive: cannot receive event handlers. -}
h1 : List (Attribute Never) -> List (Html msg) -> Html msg
h1 attrs children =
    VirtualDom.node "h1"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Heading level 2. Non-interactive. -}
h2 : List (Attribute Never) -> List (Html msg) -> Html msg
h2 attrs children =
    VirtualDom.node "h2"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Heading level 3. Non-interactive. -}
h3 : List (Attribute Never) -> List (Html msg) -> Html msg
h3 attrs children =
    VirtualDom.node "h3"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Heading level 4. Non-interactive. -}
h4 : List (Attribute Never) -> List (Html msg) -> Html msg
h4 attrs children =
    VirtualDom.node "h4"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Heading level 5. Non-interactive. -}
h5 : List (Attribute Never) -> List (Html msg) -> Html msg
h5 attrs children =
    VirtualDom.node "h5"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Heading level 6. Non-interactive. -}
h6 : List (Attribute Never) -> List (Html msg) -> Html msg
h6 attrs children =
    VirtualDom.node "h6"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A generic container with no special meaning. Non-interactive. -}
div : List (Attribute Never) -> List (Html msg) -> Html msg
div attrs children =
    VirtualDom.node "div"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A paragraph. Non-interactive. -}
p : List (Attribute Never) -> List (Html msg) -> Html msg
p attrs children =
    VirtualDom.node "p"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A thematic break between paragraphs. Non-interactive. -}
hr : List (Attribute Never) -> List (Html msg) -> Html msg
hr attrs children =
    VirtualDom.node "hr"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Preformatted text. Non-interactive. -}
pre : List (Attribute Never) -> List (Html msg) -> Html msg
pre attrs children =
    VirtualDom.node "pre"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A block quotation. Non-interactive. -}
blockquote : List (Attribute Never) -> List (Html msg) -> Html msg
blockquote attrs children =
    VirtualDom.node "blockquote"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| An inline container. Non-interactive. -}
span : List (Attribute Never) -> List (Html msg) -> Html msg
span attrs children =
    VirtualDom.node "span"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A hyperlink. Non-interactive in this module (use Html.a for clickable links). -}
a : List (Attribute Never) -> List (Html msg) -> Html msg
a attrs children =
    VirtualDom.node "a"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Computer code. Non-interactive. -}
code : List (Attribute Never) -> List (Html msg) -> Html msg
code attrs children =
    VirtualDom.node "code"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Emphasized text. Non-interactive. -}
em : List (Attribute Never) -> List (Html msg) -> Html msg
em attrs children =
    VirtualDom.node "em"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Especially important text. Non-interactive. -}
strong : List (Attribute Never) -> List (Html msg) -> Html msg
strong attrs children =
    VirtualDom.node "strong"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Alternate voice or mood text. Non-interactive. -}
i : List (Attribute Never) -> List (Html msg) -> Html msg
i attrs children =
    VirtualDom.node "i"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Text to draw attention to. Non-interactive. -}
b : List (Attribute Never) -> List (Html msg) -> Html msg
b attrs children =
    VirtualDom.node "b"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Underlined text annotation. Non-interactive. -}
u : List (Attribute Never) -> List (Html msg) -> Html msg
u attrs children =
    VirtualDom.node "u"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Subscript text. Non-interactive. -}
sub : List (Attribute Never) -> List (Html msg) -> Html msg
sub attrs children =
    VirtualDom.node "sub"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Superscript text. Non-interactive. -}
sup : List (Attribute Never) -> List (Html msg) -> Html msg
sup attrs children =
    VirtualDom.node "sup"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A line break. Non-interactive. -}
br : List (Attribute Never) -> Html msg
br attrs =
    VirtualDom.node "br"
        (List.map (Html.Attributes.map Basics.never) attrs)
        []


{-| A side comment or small print. Non-interactive. -}
small : List (Attribute Never) -> List (Html msg) -> Html msg
small attrs children =
    VirtualDom.node "small"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A citation or reference. Non-interactive. -}
cite : List (Attribute Never) -> List (Html msg) -> Html msg
cite attrs children =
    VirtualDom.node "cite"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A term being defined. Non-interactive. -}
dfn : List (Attribute Never) -> List (Html msg) -> Html msg
dfn attrs children =
    VirtualDom.node "dfn"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| An abbreviation or acronym. Non-interactive. -}
abbr : List (Attribute Never) -> List (Html msg) -> Html msg
abbr attrs children =
    VirtualDom.node "abbr"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A date and time value. Non-interactive. -}
time : List (Attribute Never) -> List (Html msg) -> Html msg
time attrs children =
    VirtualDom.node "time"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| A variable in a formula or code. Non-interactive. -}
var : List (Attribute Never) -> List (Html msg) -> Html msg
var attrs children =
    VirtualDom.node "var"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Sample output from a program. Non-interactive. -}
samp : List (Attribute Never) -> List (Html msg) -> Html msg
samp attrs children =
    VirtualDom.node "samp"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| User input (keyboard). Non-interactive. -}
kbd : List (Attribute Never) -> List (Html msg) -> Html msg
kbd attrs children =
    VirtualDom.node "kbd"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Content no longer accurate or relevant. Non-interactive. -}
s : List (Attribute Never) -> List (Html msg) -> Html msg
s attrs children =
    VirtualDom.node "s"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| An inline quotation. Non-interactive. -}
q : List (Attribute Never) -> List (Html msg) -> Html msg
q attrs children =
    VirtualDom.node "q"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Highlighted text for reference. Non-interactive. -}
mark : List (Attribute Never) -> List (Html msg) -> Html msg
mark attrs children =
    VirtualDom.node "mark"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Ruby annotation container. Non-interactive. -}
ruby : List (Attribute Never) -> List (Html msg) -> Html msg
ruby attrs children =
    VirtualDom.node "ruby"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Ruby annotation text. Non-interactive. -}
rt : List (Attribute Never) -> List (Html msg) -> Html msg
rt attrs children =
    VirtualDom.node "rt"
        (List.map (Html.Attributes.map Basics.never) attrs)
        children


{-| Ruby annotation parenthesis. Non-interactive. -}
rp : List (Attribute Never) -> List (Html msg) -> Html msg
rp attrs children =
    VirtualDom.node "rp"
