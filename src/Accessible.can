-- HELPERS


{-| CSS styles that make an element visually hidden but still
accessible to screen readers.
-}
invisibleStyles : List (Html.Attribute msg)
invisibleStyles =
    [ VirtualDom.style "position" "absolute"
    , VirtualDom.style "width" "1px"
    , VirtualDom.style "height" "1px"
    , VirtualDom.style "padding" "0"
    , VirtualDom.style "margin" "-1px"
    , VirtualDom.style "overflow" "hidden"
    , VirtualDom.style "clip" "rect(0, 0, 0, 0)"
    , VirtualDom.style "white-space" "nowrap"
    , VirtualDom.style "border" "0"
    ]
